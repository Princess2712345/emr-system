datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/db-client"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  username   String   @unique
  password   String
  firstName  String
  middleName String?
  lastName   String
  role       Role     @default(PATIENT)
  uniqueId   String   @unique
  createdAt  DateTime @default(now())
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String        @default("N/A")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  bills        Invoice[]
  labResults   LabResult[]
  dispositions Disposition[] // Added bidirectional relation back-reference link
}

model Appointment {
  id          Int      @id @default(autoincrement())
  date        DateTime // Stores the calendar day
  time        String   // e.g., "09:00 AM" or "14:30"
  duration    String   // e.g., "30 min", "45 min"
  reason      String   // Reason for checkup or clinical emergency
  status      String   @default("Pending") // "Confirmed", "Pending", "Urgent", "In Progress"
  
  patientId   String
  patientName String   // Snapshot string to keep dashboard loads fast
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LabResult {
  id           String   @id @default(uuid())
  testName     String
  patientId    String
  createdAt    DateTime @default(now())
  category     String
  colorClass   String   @default("teal")
  dateReported DateTime @default(now())
  filePath     String?
  patientName  String
  requestId    String   @unique
  status       String   @default("Pending")
  uploadedBy   String?
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  amount      Float    @default(0.00)
  balance     Float    @default(0.00)
  dueDate     DateTime
  status      String   @default("Unpaid") // Valid states: "Paid", "Unpaid", "Partial"
  patientId   String
  patientName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Disposition {
  id          String   @id @default(uuid())
  patientName String
  patientId   String   
  type        String   
  physician   String
  dateTime    DateTime @default(now()) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade) // Integrated relation constraints safely
}

model Inventory {
  id        String   @id @default(uuid())
  name      String
  category  String   
  stock     Int      @default(0)
  unit      String   @default("pcs") 
  price     Float    @default(0.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  HR
  REGISTRAR
  PATIENT
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  user      String   // Stores the username or email (e.g., "Admin_Maria", "System")
  action    String   // Description of what happened (e.g., "Modified Patient Record")
  resource  String   // What entity was affected (e.g., "P-2024-001")
  severity  String   // "Info", "Warning", or "Critical"

  @@index([severity]) // Speeds up queries when filtering by severity level on your dashboard history layout
}