datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // <-- Make sure this line is here!
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/db-client"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  username   String   @unique
  password   String
  firstName  String
  middleName String?
  lastName   String
  role       Role     @default(PATIENT)
  uniqueId   String   @unique
  createdAt  DateTime @default(now())
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String        @default("N/A")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  bills        Invoice[]
  labResults   LabResult[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String   @default("SCHEDULED")
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LabResult {
  id           String   @id @default(uuid())
  testName     String
  patientId    String
  createdAt    DateTime @default(now())
  category     String
  colorClass   String   @default("teal")
  dateReported DateTime @default(now())
  filePath     String?
  patientName  String
  requestId    String   @unique
  status       String   @default("Pending")
  uploadedBy   String?
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        Int      @id @default(autoincrement())
  amount    Float
  isPaid    Boolean  @default(false)
  patientId String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  HR
  REGISTRAR
  PATIENT
}
