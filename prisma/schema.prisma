datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/db-client"
}

enum Role {
  ADMIN
  HR
  REGISTRAR
  PATIENT
  DOCTOR 
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  username          String        @unique
  password          String
  firstName         String
  middleName        String?
  lastName          String
  role              String        @default("PATIENT") 
  uniqueId          String        @unique
  age               Int?          @default(24)
  bloodType         String?       @default("O Positive")
  phone             String?
  avatar            String?       @db.Text
  status            String        @default("Active")   
  createdAt         DateTime      @default(now())

  // Relation pointing to patient files if this user is a PATIENT
  patientProfile    Patient? 
  
  // Connects Admins/Staff/Doctors directly to their scheduled patient appointments
  staffAppointments Appointment[] @relation("StaffAppointments")
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String        @default("N/A")
  gender       String?
  birthDate    DateTime?
  status       String        @default("Active")

  // Patient-editable profile details
  avatar                    String?   @db.Text
  address                   String?
  allergies                 String?
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?
  insuranceProvider         String?
  insuranceNumber           String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Clinical profile linked to portal login (User) by email
  userAccount  User          @relation(fields: [email], references: [email], onDelete: Cascade)

  appointments Appointment[]
  bills        Invoice[]
  labResults   LabResult[]
  dispositions Disposition[]
  medicationRefills MedicationRefill[]
  medications      PatientMedication[]

  @@index([status])
  @@index([createdAt])
}

model Appointment {
  id          Int      @id @default(autoincrement())
  date        DateTime 
  time        String   
  duration    String   
  reason      String   
  status      String   @default("Pending") 
  
  patientId   String
  patientName String   
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  // Replaced doctorId with staffId pointing to the User model account
  staffId     String?  
  staff       User?    @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@index([staffId])
}

model LabResult {
  id             String    @id @default(uuid())
  testName       String
  patientId      String
  createdAt      DateTime  @default(now())
  category       String
  colorClass     String    @default("teal")
  dateReported   DateTime  @default(now())
  filePath       String?
  patientName    String
  requestId      String    @unique
  status         String    @default("Pending")
  uploadedBy     String?
  findings       String?
  interpretation String?
  resultDetails  Json?
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Invoice {
  id            String   @id @default(cuid())
  amount        Float    @default(0.00)
  balance       Float    @default(0.00)
  dueDate       DateTime
  status        String   @default("Unpaid") 
  patientId     String
  patientName   String
  // Itemized breakdown entered by admin: [{ description, amount }]
  items         Json?
  // Payment review workflow
  paymentMethod String?
  paymentRef    String?
  paymentProof  String?  @db.Text
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Disposition {
  id          String   @id @default(uuid())
  patientName String
  patientId   String   
  type        String   
  physician   String
  dateTime    DateTime @default(now()) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientMedication {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  dose         String   @default("")
  timing       String   @default("")
  prescribedBy String?
  status       String   @default("Active")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model MedicationRefill {
  id          String    @id @default(uuid())
  patientId   String
  patientName String
  medications Json
  status      String    @default("Pending")
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model Inventory {
  id        String   @id @default(uuid())
  name      String
  category  String   
  stock     Int      @default(0)
  unit      String   @default("pcs") 
  price     Float    @default(0.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  user      String   
  action    String   
  resource  String   
  severity  String   

  @@index([severity])
}