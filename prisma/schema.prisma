// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  // The url line is gone!
}

generator client {
  provider = "prisma-client-js"
}

// 1. User Authentication (For login.vue and register.vue)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique  // Add this line
  password  String
  role      Role     @default(PATIENT)
  uniqueId  String   @unique  // Add this line (for Staff # or MRN #)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  PATIENT
}


// 2. Patient Management (The core of your EMR)
model Patient {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  phone        String?
  appointments Appointment[]
  labResults   LabResult[]
  bills        Invoice[]
  createdAt    DateTime      @default(now())
}

// 3. Appointments (For appointments.vue)
model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String   @default("SCHEDULED") // e.g., PENDING, COMPLETED, CANCELLED
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])
}

// 4. Lab Results (For lab-results.vue)
model LabResult {
  id         Int      @id @default(autoincrement())
  testName   String
  result     String
  patientId  Int
  patient    Patient  @relation(fields: [patientId], references: [id])
  createdAt  DateTime @default(now())
}

// 5. Billing & Invoices (For billing.vue)
model Invoice {
  id        Int      @id @default(autoincrement())
  amount    Float
  isPaid    Boolean  @default(false)
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])
  createdAt DateTime @default(now())
}